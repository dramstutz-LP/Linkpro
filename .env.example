# Copy to .env and fill in from https://dashboard.stripe.com/test/apikeys

# Server (local dev)
PORT=8080
BASE_URL=http://localhost:8080

# Production (set in Vercel → Settings → Environment Variables)
# BASE_URL=https://yourdomain.com

# Stripe keys (use test keys while developing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — create Products + Prices in the Stripe Dashboard, then paste IDs here
STRIPE_PRICE_PELVIS_1=price_...
STRIPE_PRICE_LLIP=price_...
STRIPE_PRICE_SEMINAR=price_...

# Vercel webhook URL (after deploy):
# https://yourdomain.com/api/webhooks/stripe
